# systemd unit for the alignment game backend.
#
# Keeps the Python server running (restarts it if it crashes or the droplet
# reboots) as an unprivileged user, bound to localhost behind Caddy. Install:
#   sudo cp deploy/alignment.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now alignment
#   systemctl status alignment

[Unit]
Description=Alignment game backend (stdlib HTTP server)
After=network.target

[Service]
# Unprivileged service account created in the runbook (deploy/README.md).
User=alignment
WorkingDirectory=/opt/alignment_game

# ALIGNMENT_DEPLOY=production closes the debug Truth endpoint and marks the
# session cookie Secure. HOST/PORT keep the server on localhost behind Caddy.
Environment=ALIGNMENT_DEPLOY=production HOST=127.0.0.1 PORT=8000
ExecStart=/usr/bin/python3 -m backend_v1.server.server

Restart=always
RestartSec=2

# Light process hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
