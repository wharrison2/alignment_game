# Caddy reverse proxy for the alignment game.
#
# Caddy terminates TLS for you: on first start (with the domain's DNS already
# pointing at this droplet and ports 80/443 open) it automatically obtains and
# renews a free Let's Encrypt certificate, and redirects all HTTP to HTTPS. The
# Python backend stays on localhost:8000 and is never exposed directly.
#
# This file is machine-independent — copy it verbatim, no editing. The domain is
# read from the DOMAIN environment variable (set once via `systemctl edit caddy`,
# see deploy/README.md Step 6), so a `git pull` never clobbers a per-host value.
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# If DOMAIN is unset, Caddy fails to load loudly (empty site address) — that's the
# intended safety: it won't silently serve the wrong name.

# Global options: explicit timeouts blunt slow-client (slowloris) connection
# holding at the edge, before anything reaches the backend.
{
	servers {
		timeouts {
			read_body   10s
			read_header 5s
			idle        2m
		}
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode gzip

	# Reject oversized request bodies at the edge (the backend also caps this).
	request_body {
		max_size 64KB
	}

	# Forward everything to the internal Python server (systemd unit `alignment`).
	reverse_proxy 127.0.0.1:8000

	# Security headers. HSTS tells browsers to only ever use HTTPS for this site.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "no-referrer"
		# Don't advertise the server software.
		-Server
	}
}
